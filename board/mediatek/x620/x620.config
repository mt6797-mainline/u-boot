CONFIG_ARM=y
CONFIG_ARM64=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_TARGET_MT6797_X620=y
CONFIG_TEXT_BASE=0x40080000
CONFIG_LNX_KRNL_IMG_TEXT_OFFSET_BASE=0x40000000
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x43000000
CONFIG_SYS_LOAD_ADDR=0x48000000
CONFIG_SYS_MALLOC_LEN=0x400000
CONFIG_SYS_MALLOC_F_LEN=0x8000
CONFIG_NR_DRAM_BANKS=1
CONFIG_DEFAULT_DEVICE_TREE="mt6797-x620-uboot"
CONFIG_OF_CONTROL=y
CONFIG_OF_SEPARATE=y
# CONFIG_ARCH_FIXUP_FDT_MEMORY is not set
# CONFIG_OF_UPSTREAM is not set
CONFIG_ENV_IS_NOWHERE=y
CONFIG_ENV_SIZE=0x2000
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="x620diag; x620usb; x620stay"
CONFIG_BOOTDELAY=-2
CONFIG_HUSH_PARSER=y
CONFIG_SYS_PROMPT="X620=> "
CONFIG_CONSOLE_MUX=y
CONFIG_EVENT=y
CONFIG_PANIC_HANG=y
CONFIG_CONSOLE_RECORD=y
CONFIG_CONSOLE_RECORD_INIT_F=y
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x10000
CONFIG_CONSOLE_RECORD_OUT_SIZE_F=0x2000
CONFIG_DM_SERIAL=y
CONFIG_MTK_SERIAL=y
CONFIG_BAUDRATE=921600
CONFIG_VIDEO=y
CONFIG_VIDEO_BPP32=y
CONFIG_VIDEO_FONT_16X32=y
CONFIG_SYS_WHITE_ON_BLACK=y
# CONFIG_VIDEO_FONT_8X16 is not set
# CONFIG_VIDEO_LOGO is not set
# CONFIG_VIDEO_REMOVE is not set
CONFIG_CMD_BOOTI=y
CONFIG_CMD_BOOTM=y
CONFIG_SUPPORT_RAW_INITRD=y
CONFIG_FIT=y
CONFIG_ANDROID_BOOT_IMAGE=y
CONFIG_GZIP=y
CONFIG_CMD_FDT=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_DM=y
CONFIG_CMD_BDI=y
CONFIG_CMD_CONSOLE=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_SLEEP=y
CONFIG_CMD_CRC32=y
CONFIG_CMD_HASH=y
CONFIG_HASH=y
CONFIG_SHA256=y
CONFIG_CMD_MEMINFO=y
CONFIG_ARM_PSCI_FW=y
CONFIG_PSCI_RESET=y
# CONFIG_EFI_LOADER is not set
# CONFIG_NET is not set
# CONFIG_MMC is not set
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_DM_USB_GADGET=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_GADGET=y
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_USB_GADGET_VENDOR_NUM=0x0e8d
CONFIG_USB_GADGET_PRODUCT_NUM=0x201c
CONFIG_USB_GADGET_MANUFACTURER="X620 relay"
CONFIG_CMD_FASTBOOT=y
CONFIG_FASTBOOT_CMD_OEM_CONSOLE=y
CONFIG_FASTBOOT_OEM_RUN=y
CONFIG_FASTBOOT_BUF_ADDR=0x48000000
CONFIG_FASTBOOT_BUF_SIZE=0x4000000
# CONFIG_FASTBOOT_FLASH is not set
# CONFIG_FASTBOOT_UUU_SUPPORT is not set
CONFIG_CLK=y
CONFIG_PHY=y
CONFIG_DM_REGULATOR=y
CONFIG_DM_REGULATOR_FIXED=y
# CONFIG_WDT is not set
# CONFIG_WATCHDOG is not set
# CONFIG_SPL is not set
# CONFIG_TOOLS_MKEFICAPSULE is not set
# CONFIG_TOOLS_MKFWUMDATA is not set
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_TOOLS_KWBIMAGE is not set
